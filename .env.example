# --- Server ---
PORT=3000

# --- Database ---
# Local dev: mongodb://127.0.0.1:27017/patient_registration
# Production (Render): a MongoDB Atlas free-tier (M0) connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/patient_registration?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/patient_registration

# --- Vapi webhook + LLM proxy security ---
# Shared secret used two ways: (1) Vapi sends it back in the "x-vapi-secret"
# header on every webhook call; (2) Vapi's custom-llm client sends it as a
# Bearer token to this app's /llm/chat/completions proxy. Same value in
# both the Vapi assistant's serverUrlSecret and the custom-llm credential.
VAPI_SERVER_SECRET=change-me

# --- Read by the NestJS app itself (src/llm-proxy) ---
# Your Google AI Studio / Gemini API key. Used server-side by
# /llm/chat/completions to call Google's OpenAI-compatible Gemini endpoint
# on Vapi's behalf — Vapi never receives this key directly. See README
# section 9 for why this proxy exists instead of pointing Vapi at Google
# directly (Vapi's custom-llm client attaches a `metadata` field to every
# request that Google's strict endpoint rejects outright).
GEMINI_API_KEY=

# --- Used only by scripts/setup-vapi.sh (not read by the NestJS app) ---
# Your Vapi private API key, from the Vapi dashboard (Settings > API Keys).
VAPI_API_KEY=
# Public HTTPS URL of this API once deployed (e.g. your Render domain), used
# as both the tool-call serverUrl and the custom-llm base URL when creating
# the Vapi assistant.
PUBLIC_API_BASE_URL=https://your-app.onrender.com
