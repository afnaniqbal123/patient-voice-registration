# --- Server ---
PORT=3000

# --- Database ---
# Local dev: mongodb://127.0.0.1:27017/patient_registration
# Railway: use the MONGO_URL/MONGO_PUBLIC_URL variable reference from the
# MongoDB plugin (Railway auto-injects this as a service variable reference).
MONGODB_URI=mongodb://127.0.0.1:27017/patient_registration

# --- Vapi webhook security ---
# Shared secret Vapi sends back in the "x-vapi-secret" header on every
# webhook call. Set the same value in the Vapi assistant's serverUrlSecret.
VAPI_SERVER_SECRET=change-me

# --- Used only by scripts/setup-vapi.sh (not read by the NestJS app) ---
# Your Vapi private API key, from the Vapi dashboard (Settings > API Keys).
VAPI_API_KEY=
# Your Google AI Studio / Gemini API key, added as a Vapi provider key so
# Vapi can call Gemini on your behalf.
GEMINI_API_KEY=
# Public HTTPS URL of this API once deployed (e.g. Railway domain), used as
# the tool-call serverUrl when creating the Vapi assistant.
PUBLIC_API_BASE_URL=https://your-app.up.railway.app
